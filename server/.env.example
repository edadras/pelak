# ---- Security (change these!) ----
SECRET_KEY=please-change-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
POSTGRES_PASSWORD=change-me

# ---- Web ----
HTTP_PORT=8080
TOKEN_HOURS=12
# Map tiles; point to a local tile server for offline networks
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_CENTER=35.6997,51.3380

# ---- Vision workers ----
WORKERS=1                 # number of worker containers on this server
WORKER_MAX_CAMERAS=8      # cameras per worker (CPU: 2-4 per 4 cores, GPU: 16-32)
DEVICE=cpu                # cpu | cuda | cuda:0
PROCESS_FPS=6             # analysed frames per second per camera
VEHICLE_MODEL=/app/model/yolov8n.pt   # yolov8s.pt / yolov8m.pt for higher accuracy on GPU
VEHICLE_CONF=0.35
PLATE_CONF=0.25
CHAR_CONF=0.25
STREAM_FPS=5
STREAM_WIDTH=960
RETENTION_DAYS=90
# SEED_EXAMPLES=1         # create example districts/rules on first start
# DEMO_VIDEO=/app/server/data/videos/sample.mp4
